# 阿里云百炼（按量付费）
# API Key：https://bailian.console.aliyun.com/
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# [可选] 阿里云百炼 Token Plan（订阅套餐专用端点）
# 仅含套餐内模型，没有 embedding 模型；批量刷新 notebook 输出时用它可省按量费用
# DASHSCOPE_TOKEN_BASE_URL=
# DASHSCOPE_TOKEN_API_KEY=

# Tavily（可选，11.web_search 教程使用；不配置则运行时会向你询问）
# TAVILY_API_KEY=

# [可选] 字节火山方舟（app/ 的备选 LLM 提供商）
# API Key：https://console.volcengine.com/ark/
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=
